---
import BrandLogo from './NextLogo.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const loginUrl = 'https://app.volontariando.it';
const routeWithLang = (hash: string) => `/${lang}/#${hash}`;
---

<nav class="fixed inset-x-0 top-0 z-50 border-b border-slate-200/70 bg-white/80 backdrop-blur-md">
	<div class="mx-auto flex h-16 w-full max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
		<a href={routeWithLang('top')} class="inline-flex items-center gap-2.5">
			<BrandLogo class="h-8 w-8 shrink-0" />
			<span class="text-xl font-black tracking-tight text-slate-900">Volontariando</span>
		</a>

		<div class="hidden items-center gap-7 md:flex">
			<a href={routeWithLang('volontari')} class="text-sm font-medium text-slate-600 transition-colors hover:text-blue-600">{t.nav.volunteers}</a>
			<a href={routeWithLang('associazioni')} class="text-sm font-medium text-slate-600 transition-colors hover:text-emerald-600">{t.nav.associations}</a>
			<a href={routeWithLang('imprese')} class="text-sm font-medium text-slate-600 transition-colors hover:text-violet-600">{t.nav.companies}</a>
		</div>

		<div class="flex items-center gap-3">
			<a
				href={loginUrl}
				class="inline-flex items-center rounded-full bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-[0_8px_20px_rgba(37,99,235,0.25)] transition-transform duration-300 hover:scale-[1.02]"
			>
				Accedi<span class="hidden md:inline">&nbsp;alla piattaforma</span>
			</a>
		</div>

	</div>
</nav>

<div id="top" class="h-16 scroll-mt-24"></div>
